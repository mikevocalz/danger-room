+     * anchor, translate to (cx*width, cy*height), then buffer px -> NDC. All in
+     * the y-down convention established by the camera pass (no flip).
+     */
+    private void buildOverlayTransform(FaceState f, Template t, int width, int height, int rotation) {
+        // f.* arrive in the detector's ROTATION-CORRECTED upright frame (MLKit /
+        // JS faceAnchor.ts: portrait ~0.75 on a portrait phone), but this buffer
+        // is sensor-oriented and VideoFrame(buffer, rotation, ..) rotates it
+        // DOWNSTREAM. Compositing display-space coords into the unrotated buffer
+        // is what painted the cowl rotated ~90deg, ~1.78x oversized and offset.
+        // Map upright -> buffer by the inverse of `rotation` (all y-down):
+        //   display = rotateCW(buffer, rotation)  =>  buffer = rotateCW^-1(display)
+        float ucx;
+        float ucy;
+        switch (rotation) {
+            case 90:  ucx = f.cy;      ucy = 1f - f.cx; break;
+            case 180: ucx = 1f - f.cx; ucy = 1f - f.cy; break;
+            case 270: ucx = 1f - f.cy; ucy = f.cx;      break;
+            default:  ucx = f.cx;      ucy = f.cy;      break;
