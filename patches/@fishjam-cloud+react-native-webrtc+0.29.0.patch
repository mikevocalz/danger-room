+package com.oney.WebRTCModule;
+
+import android.util.Log;
+import android.view.Surface;
+
+import org.webrtc.EglBase;
+import org.webrtc.EglRenderer;
+import org.webrtc.GlRectDrawer;
+import org.webrtc.MediaStream;
+import org.webrtc.VideoTrack;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * DANGER-ROOM PATCH — external Surface consumers for WebRTC video tracks.
+ *
+ * Static registry that renders a WebRTC {@link VideoTrack} into an arbitrary
+ * app-supplied {@link Surface}. The consumer (Viro's VRTExternalVideo, which
+ * exposes a virocore ExternalSurfaceTexture) calls {@link #provideSurface} /
+ * {@link #revokeSurface} REFLECTIVELY, so neither library takes a compile-time
+ * dependency on the other; the method signatures are the contract.
+ *
+ * key = the stream's react tag (JS: `mediaStream.toURL()`). The first video
+ * track of that stream is rendered into the Surface via an {@link EglRenderer}
+ * sharing the module's root EGL context.
+ *
+ * Threading: provideSurface may arrive from Viro's rendering thread; all
+ * WebRTC-touching work hops to the module's executor via ThreadUtils, matching
+ * getStreamForReactTag's "must be called in the executor" contract.
+ */
+public final class ExternalVideoSurfaces {
+
+    private static final String TAG = "ExternalVideoSurfaces";
+
+    /** Set by WebRTCModule's constructor (patched); needed for stream lookup. */
+    static volatile WebRTCModule sModule;
+
+    private static final class Sink {
+        EglRenderer renderer;
+        VideoTrack track;
+    }
+
+    private static final Map<String, Sink> sSinks = new HashMap<>();
+
+    private ExternalVideoSurfaces() {}
+
+    /**
+     * Render the first video track of the stream tagged {@code key} into
+     * {@code surface}. Called reflectively by the consumer; replaces any
+     * previous surface for the same key.
+     */
+    public static void provideSurface(String key, Surface surface, int width, int height) {
+        ThreadUtils.runOnExecutor(() -> {
+            revokeLocked(key);
+
+            WebRTCModule module = sModule;
+            if (module == null) {
+                Log.e(TAG, "provideSurface(" + key + "): WebRTCModule not initialized");
+                return;
+            }
+            MediaStream stream = module.getStreamForReactTag(key);
+            if (stream == null || stream.videoTracks.isEmpty()) {
+                Log.e(TAG, "provideSurface(" + key + "): no stream/video track for tag");
+                return;
+            }
+
+            Sink sink = new Sink();
+            sink.track = stream.videoTracks.get(0);
+            sink.renderer = new EglRenderer("ExternalVideoSurfaces:" + key);
+            sink.renderer.init(EglUtils.getRootEglBaseContext(),
+                    EglBase.CONFIG_PLAIN, new GlRectDrawer());
+            sink.renderer.createEglSurface(surface);
+            sink.track.addSink(sink.renderer);
+            sSinks.put(key, sink);
+            Log.i(TAG, "provideSurface(" + key + "): sink attached (" + width + "x" + height + ")");
+        });
+    }
+
+    /** Stop rendering for {@code key} and release the EGL surface + renderer. */
+    public static void revokeSurface(String key) {
+        ThreadUtils.runOnExecutor(() -> revokeLocked(key));
+    }
+
+    // Must be called on the executor.
+    private static void revokeLocked(String key) {
+        Sink sink = sSinks.remove(key);
+        if (sink == null) return;
+        try {
+            sink.track.removeSink(sink.renderer);
+        } catch (Exception e) {
+            Log.w(TAG, "removeSink failed (track disposed?)", e);
+        }
+        sink.renderer.releaseEglSurface(() -> {});
+        sink.renderer.release();
+        Log.i(TAG, "revokeSurface(" + key + "): sink released");
+    }
+}
