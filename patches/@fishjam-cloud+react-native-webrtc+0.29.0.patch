+     */
+    void setOverlayImage(String base64Png, double imgW, double imgH, double tplIod, double anchorX, double anchorY) {
+        Bitmap bitmap = null;
+        if (base64Png != null && !base64Png.isEmpty()) {
+            try {
+                byte[] bytes = Base64.decode(base64Png, Base64.DEFAULT);
+                bitmap = BitmapFactory.decodeByteArray(bytes, 0, bytes.length);
+            } catch (Exception e) {
+                Log.e(TAG, "OverlayCompositor: failed to decode overlay image", e);
+            }
+            if (bitmap == null) {
+                Log.e(TAG, "OverlayCompositor: overlay image decode returned null");
+                return;
+            }
+        }
