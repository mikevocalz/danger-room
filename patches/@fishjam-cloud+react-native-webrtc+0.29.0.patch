+/**
+ * Composites a face-tracked ARGB overlay (e.g. a cowl PNG) onto published camera
+ * frames so REMOTE peers see it.
+ *
+ * <p>The camera frame arrives as a {@code GL_TEXTURE_EXTERNAL_OES} texture (an
+ * imported AHardwareBuffer) which cannot be an FBO attachment, so compositing is
+ * done by DRAWING: camera quad + overlay quad into a fresh RGBA
+ * {@code GL_TEXTURE_2D} taken from a small pool, which is then shipped to the
+ * encoder as a {@code Type.RGB} {@link org.webrtc.TextureBufferImpl}.
+ *
+ * <h2>Threading</h2>
+ * State setters ({@link #setEnabled}, {@link #setFace}, {@link #setOverlayImage})
+ * may be called from any thread; {@link #compositeIfActive} runs ONLY on the
+ * custom-video GL thread (see {@link CustomVideoFrameDelivery}), whose EGL
+ * context shares with WebRTC's encoder context — so the pool textures created
+ * here are encoder-visible. {@link #releaseOutput} is thread-safe (no GL calls).
+ *
+ * <h2>Y-axis convention</h2>
+ * The camera pass is an IDENTITY copy: quad NDC(-1,-1) samples camera UV(0,0),
+ * so output texel row N == camera texel row N and the shipped buffer has the
+ * exact row order of the untouched OES path. Camera texel row 0 is the image
+ * TOP row, therefore in this FBO's NDC space y=-1 is the image TOP: image-space
+ * "y down from top" maps to NDC as {@code y_ndc = 2*y_px/height - 1} with NO
+ * flip. The overlay transform is built in that same y-down pixel space (and the
+ * overlay PNG uploads with its top row at v=0, so an un-rotated overlay quad is
+ * upright), which keeps the overlay pass in the SAME convention as the camera
+ * pass — the overlay lands exactly where the face is. Positive {@code roll}
+ * rotates the overlay clockwise on screen (y-down convention); negate on the JS
+ * side if the tracker uses the opposite sign.
+ */
+final class OverlayCompositor {
+    private static final String TAG = WebRTCModule.TAG;
+    private static final int POOL_SIZE = 3;
+
+    private static final OverlayCompositor INSTANCE = new OverlayCompositor();
+
+    static OverlayCompositor getInstance() {
+        return INSTANCE;
+    }
+
+    private OverlayCompositor() {}
+
+    // --- Cross-thread state (written from any thread, read on the GL thread). ---
+
+    /** Immutable face pose snapshot; frame-normalized (cx,cy in 0..1, iod = px/frameWidth). */
+    private static final class FaceState {
+        final boolean present;
+        final float cx;
+        final float cy;
+        final float iod;
+        final float roll;
+
+        FaceState(boolean present, float cx, float cy, float iod, float roll) {
+            this.present = present;
+            this.cx = cx;
+            this.cy = cy;
+            this.iod = iod;
+            this.roll = roll;
+        }
+    }
+
+    /** Immutable overlay template: anchor/iod measured in overlay-image pixels. */
+    private static final class Template {
+        final float tplIod;
+        final float anchorX;
+        final float anchorY;
+        final float imgW;
+        final float imgH;
+
+        Template(float tplIod, float anchorX, float anchorY, float imgW, float imgH) {
+            this.tplIod = tplIod;
+            this.anchorX = anchorX;
+            this.anchorY = anchorY;
+            this.imgW = imgW;
+            this.imgH = imgH;
+        }
+    }
+
+    private volatile boolean enabled = false;
+    private volatile FaceState face = null;
+    private volatile Template template = null;
+
+    /** Decoded overlay bitmap awaiting GL upload; guarded by {@code bitmapLock}. */
+    private final Object bitmapLock = new Object();
+    private Bitmap pendingBitmap = null;
+
+    /** Pool slot bookkeeping; guarded by {@code poolLock} (releaseOutput is any-thread). */
+    private final Object poolLock = new Object();
+    private final int[] poolTextures = new int[POOL_SIZE];
+    private final boolean[] poolBusy = new boolean[POOL_SIZE];
+
+    // --- GL objects; touched ONLY on the GL thread. ---
