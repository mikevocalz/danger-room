+        }
+    }
+
+    // --- Output pool (releaseOutput: any thread; no GL calls). ---
+
+    /** Frees the pool slot holding {@code texId}, making it reusable for a later frame. */
+    void releaseOutput(int texId) {
+        synchronized (poolLock) {
+            for (int i = 0; i < POOL_SIZE; i++) {
+                if (poolTextures[i] == texId) {
+                    poolBusy[i] = false;
+                    return;
+                }
+            }
+        }
+    }
+
+    // --- GL-thread entry point. ---
+
+    /**
+     * Composites camera + overlay into a pooled RGBA texture. MUST be called on
+     * the custom-video GL thread with its EGL context current.
+     *
+     * @return the composited GL_TEXTURE_2D id, or -1 to keep the original OES
+     *         path (disabled / no face / no overlay / pool exhausted / GL error).
+     *         A returned id MUST be handed back via {@link #releaseOutput(int)}.
+     */
